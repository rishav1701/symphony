# ──────────────────────────────────────────────
#  Symphony Auditorium — Environment Variables
# ──────────────────────────────────────────────

# Site URL (used for SEO canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL=https://symphonyauditorium.example

# WhatsApp number (international format, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000

# Show placeholder indicators in dev mode
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Allow search-engine indexing (set to true for launch)
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Email / Enquiry Provider ──────────────────
# Uncomment ONE provider block to enable server-side enquiries.
# Without a provider, the form falls back to mailto.

# --- Resend ---
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=noreply@symphonyauditorium.example
# RESEND_TO_EMAIL=hello@symphonyauditorium.example

# --- EmailJS ---
# EMAILJS_SERVICE_ID=service_xxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxx
# EMAILJS_USER_ID=user_xxxxx

# --- Formspree ---
# FORMSPREE_FORM_ID=xxxxx

# ── GitHub API (Admin Availability Manager) ──
# Create a GitHub PAT with "contents: read/write" scope
# for the repo that stores availability.json.
# The PAT is server-side only (never sent to the browser).
GITHUB_TOKEN=ghp_YOUR_PERSONAL_ACCESS_TOKEN
NEXT_PUBLIC_GITHUB_OWNER=your-github-username
NEXT_PUBLIC_GITHUB_REPO=your-repo-name
NEXT_PUBLIC_GITHUB_FILE_PATH=data/availability.json
NEXT_PUBLIC_GITHUB_BRANCH=main
